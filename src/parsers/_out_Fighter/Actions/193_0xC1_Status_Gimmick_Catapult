// Status_Gimmick_Catapult
[statusAnimCmd_GimmickCatapult]
Action 0xC1: ENTRY {
  ChangeAction(11, R(Button Press(Jump)))
  ChangeAction(11, R(Button Press(Attack)))
  ChangeAction(11, R(Button Press(Special)))

  ChangeAction(11, R(Compare(Variable_Float_Controller_Stick_Y >= Common_Param_Float_Jump_Stick_Y)))
  AdditionalRequirement(R(Compare(Variable_Int_Controller_Flick_Y < Common_Param_Int_Jump_Initial_Frame)))
  AdditionalRequirement(R(Tap Jump On & C-Stick not Held()))
}

Action 0xC1 : EXIT {
}