// Status_Guard
[statusAnimCmd_Guard]
Action 0x1B: ENTRY {

  ChangeAction(126, R(In Air()))
  AdditionalRequirement(R(Has Passed Over an Edge Backward()))

  ChangeAction(14, R(In Air()))
  SubRoutine(statusAnimCmd_GuardCont)
  ChangeAction(86, R(Compare(LA-Float[0x03] < 0.0)))

  ChangeAction(28, R(Button Not Pressed(Shield)))
  AdditionalRequirement(R(Compare(RA-Int[0x00] <= 0.0)))
  AdditionalRequirement(R(On Ground()))

  ConcurrentInfiniteLoop(I(9), statusAnimCmd_GuardUniq)
}

[statusAnimCmdExit_Guard]
Action 0x1B : EXIT {
  } else {
  if (R(Compare(Variable_Int_Status_Kind == 27.0)) || R(Compare(Variable_Int_Status_Kind == 29.0))) {
    TerminateGraphicEffect(20, true, true)
    TerminateGraphicEffect(21, true, true)
  }
}