// Status_Air_Lasso_Hang
[statusAnimCmd_AirLassoHang]
Action 0x81: ENTRY {
  ChangeSubAction(236)
  BasicVariableIncrement(LA-Int[0x3E])
  SynchronousTimer(1.0)
  ChangeAction(14, R(NOT Hasn't Tethered 3 Times()))
  ChangeAction(22, R(On Ground()))
  AllowSpecificInterrupt(AIR_LANDING)
  ChangeAction(130, R(Button Press(Attack)))
  ChangeAction(130, R(Button Press(Special)))
  ChangeAction(130, R(Button Press(Jump)))
  ChangeAction(130, R(Compare(RA-Int[0x01] <= 0.0)))

  ChangeAction(130, R(Compare(Variable_Float_Controller_Stick_Y >= Common_Param_Float_Jump_Stick_Y)))
  AdditionalRequirement(R(Compare(Variable_Int_Controller_Flick_Y < Common_Param_Int_Jump_Initial_Frame)))

  ChangeAction(14, R(Compare(Variable_Float_Controller_Stick_Y <= Common_Param_Float_Squat_Stick_Y)))
  AdditionalRequirement(R(Bit is Set(RA-Bool[0x13])))

  ChangeAction(14, R(Bit is Set(RA-Bool[0x15])))
  ConcurrentInfiniteLoop(I(9), hidden_subroutine_0x61B4)
}

[statusAnimCmdExit_AirLassoHang]
Action 0x81 : EXIT {
  if (R(Compare(Variable_Int_Status_Kind != 130.0))) {
    RemoveArticle(RA-Int[0x00])
  }
}