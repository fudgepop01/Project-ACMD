// Status_Air_Lasso
[statusAnimCmd_AirLasso]
Action 0x7F: ENTRY {
  AllowSpecificInterrupt(AIR_LANDING)
  ChangeAction(14, R(Animation End()))

  ChangeAction(128, R(Successfully tethered ledge()))
  AdditionalRequirement(R(Bit is Set(RA-Bool[0x10])))

  if (R(Subaction Exists())) {
    ChangeSubAction(234)
  }
  ConcurrentInfiniteLoop(I(9), hidden_subroutine_0x6134)
  if (R(Compare(RA-Int[0x02] >= 2.0))) {
    SelectCliffHangData(RA-Int[0x02])
    PreventSpecificInterrupt(AIR_CLIFF)
  }
}

[statusAnimCmdExit_AirLasso]
Action 0x7F : EXIT {
  if (R(Compare(Variable_Int_Status_Kind != 129.0)) && R(Compare(Variable_Int_Status_Kind != 128.0))) {
    RemoveArticle(RA-Int[0x00])
  }
}