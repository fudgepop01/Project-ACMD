// Status_Jump_Squat
[statusAnimCmd_JumpSquat]
Action 0xA: ENTRY {
  if (R(Compare(Variable_Int_Controller_Flick_Y >= Common_Param_Int_Jump_Initial_Frame)) || R(Compare(Variable_Int_Controller_Flick_Y_Dir <= 0.0))) {
    BitVariableSet(RA-Bool[0x10])
  }
  ChangeAction(11, R(Animation End()))
  ChangeActionStatus(10002, 14, R(In Air()))

  ChangeActionStatus:01(10099, 276, R(Button Press(Special)))
  AdditionalRequirement(R(Compare(Variable_Float_Controller_Stick_Y >= Common_Param_Float_Special_Stick_Y)))
  AdditionalRequirement(R(On Ground()))

  SubRoutine(hidden_subroutine_0x9A84)
  ResetFlickY()

  ChangeActionStatus:01(10091, 48, R(Button Press(Attack)))
  AdditionalRequirement(R(Compare(Variable_Float_Controller_Stick_Y >= Common_Param_Float_Attack_Hi4_Stick_Y)))
  AdditionalRequirement(R(On Ground()))

  ConcurrentInfiniteLoop(I(9), hidden_subroutine_0xDC44)
}

Action 0xA : EXIT {
}