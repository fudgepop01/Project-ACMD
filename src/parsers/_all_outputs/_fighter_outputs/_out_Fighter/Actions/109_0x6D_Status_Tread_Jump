  } else {
    ResetFlickY()
  }
  BasicVariableIncrement(LA-Int[0x05])
  BasicVariableSet(Common_Param_Int_Tread_Attack_Frame, LA-Int[0x06])
  BitVariableSet(RA-Bool[0x07])
  ChangeAction(11, R(Animation End()))
