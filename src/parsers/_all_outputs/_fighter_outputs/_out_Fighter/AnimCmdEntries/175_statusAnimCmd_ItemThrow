    } else {
      SubRoutine(hidden_subroutine_0x1905C)
    }
  } elif (R(Compare(RA-Int[0x00] == 0.0))) {
    if (R(On Ground())) {
      SubRoutine(hidden_subroutine_0x1942C)
    } else {
      SubRoutine(hidden_subroutine_0x19834)
    }
  }
  ResetFlickX()
  ResetFlickY()
  ResetButtonPress()
  SetLoop(-1) {
    if (R(Bit is Set(RA-Bool[0x10]))) {
      ChangeSubAction(RA-Int[0x00], true)
    } else {
      ChangeSubAction(RA-Int[0x00])
      BitVariableSet(RA-Bool[0x10])
    }
    if (R(On Ground())) {
      SetAerialOrOnstage(2)
      SetAirGround(15)
      SetRequirement(R(In Air()))
    } else {
      SetAerialOrOnstage(5)
      SetAirGround(0)
      SetRequirement(R(On Ground()))
    }
    LoadRest()
    BasicVariableSet(RA-Int[0x00], RA-Int[0x02])
    BasicVariableSet(RA-Int[0x01], RA-Int[0x00])
    BasicVariableSet(RA-Int[0x02], RA-Int[0x01])
  }
