// @ 0x22BE8
AttackAir {
  SubRoutine(statusAnimCmd_AttackAirCommon)
  if (R(Compare(Variable_Float_Controller_Stick_X_Abs < Common_Param_Float_Attack_Air_Neutral_X)) && R(Compare(Variable_Float_Controller_Stick_Y_Abs < Common_Param_Float_Attack_Air_Neutral_Y))) {
    ChangeSubAction(98)
    SetStalingIdWith0(2, 14)
  } else {
    if (R(Stick Direction Pressed())) {
      if (R(Compare(Variable_Float_Controller_Stick_X_Lr >= 0.0))) {
        ChangeSubAction(99)
        SetStalingIdWith0(2, 15)
      } else {
        ChangeSubAction(100)
        SetStalingIdWith0(2, 16)
      }
    } else {
      if (R(Compare(Variable_Float_Controller_Stick_Y >= 0.0))) {
        ChangeSubAction(101)
        SetStalingIdWith0(2, 17)
      } else {
        ChangeSubAction(102)
        SetStalingIdWith0(2, 18)
      }
    }
  }
  BasicVariableSet(Variable_Int_Motion_Kind, RA-Int[0x00])
}